# Copy this file to .env. Never commit a real API key.

# Live LLM gate. The current partial MVP only enforces an empty/non-empty
# LLM_API_KEY in code; keep this false unless you intentionally run live calls.
LLM_LIVE_ENABLED=false

# OpenAI-compatible LLM endpoint. Leave LLM_BASE_URL empty for the official
# OpenAI API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local persistence root. The app stores JSON and SQLite data here.
DATA_DIR=data
